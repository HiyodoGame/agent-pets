# petdeck 本地配置示例 — 全部为占位值，请勿提交真实秘密
# 用法：按需要填入值，并以各自进程的方式提供（export 或对应 env 文件）。

# bridge 服务侧 token（server/bridge.mjs 读取）。缺失时 bridge 拒绝启动。
PETDECK_BRIDGE_TOKEN=

# 前端 token（Vite 只暴露 VITE_ 前缀）。必须与 PETDECK_BRIDGE_TOKEN 一致，否则注入 401。
VITE_PETDECK_BRIDGE_TOKEN=

# 额外允许的 Origin，逗号分隔。默认已含 http://localhost:5173 与 http://127.0.0.1:5173。
PETDECK_BRIDGE_ORIGINS=

# bridge 监听端口（可选，默认 5199，仅绑定 127.0.0.1）。
PETDECK_BRIDGE_PORT=
