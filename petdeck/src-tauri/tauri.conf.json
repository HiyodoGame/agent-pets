{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetDeck",
  "version": "1.0.0-rc.1",
  "identifier": "com.hiyodogame.petdeck",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NDQwQkJCQjc4MTY1RDEKUldUUlpZRzN1d3RFZEpqZ1NvOU8yUDIvQW11VmpadFdNWW14T2M1N3VlTkphV0hUWUlUNFFEd2YK",
      "endpoints": [
        "https://github.com/HiyodoGame/agent-pets/releases/latest/download/latest.json"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "npm run fetch-node && npm run dev -- --port 5183 --strictPort",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run fetch-node && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5183 ws://127.0.0.1:5183",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    },
    "windows": [
      {
        "label": "pet",
        "title": "PetDeck",
        "url": "/pet.html",
        "width": 180,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "main",
        "title": "PetDeck | Agent 会话",
        "url": "/index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server/": "server/",
      "resources/third-party/nodejs/": "third-party/nodejs/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
